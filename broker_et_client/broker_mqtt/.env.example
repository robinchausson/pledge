# --- CONFIGURATION DU BROKER MQTT DE ZONE (Mosquitto) ---

# Port d'écoute MQTT standard (TCP non chiffré) sur la machine hôte
# - Machine dédiée / Réseau LAN physique : 1883 pour chaque machine
# - Colocalisation sur la même machine hôte : 1883 pour Zone 1, 1884 pour Zone 2
MQTT_PORT=1883

# Port d'écoute MQTTS sécurisé (TLS v1.3) sur la machine hôte
# - Machine dédiée / Réseau LAN physique : 8883 pour chaque machine
# - Colocalisation sur la même machine hôte : 8883 pour Zone 1, 8884 pour Zone 2
MQTTS_PORT=8883
