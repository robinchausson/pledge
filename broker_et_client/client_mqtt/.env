# Copiez ce fichier en .env et remplacez par les vraies IP de votre réseau local (LAN / Wi-Fi)

# IP de la machine hébergeant le Broker MQTT
LAN_IP_BROKER=10.44.72.187

# IP DE CETTE MACHINE (le Edge Node), indispensable pour que le serveur Web puisse lui envoyer des flux
LAN_IP_NODE=10.44.72.32

# Informations sur le noeud
NODE_ID=Noeud_Robin
ZONE_ID=Zone_1
