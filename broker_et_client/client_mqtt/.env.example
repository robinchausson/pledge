# --- NŒUD EDGE DE STOCKAGE & STREAMING DE ZONE ---

# Identifiant unique de ce nœud Edge sur le réseau
# Exemples : Noeud_Edge_Zone_1 (PC Fixe), Noeud_Edge_Jetson_Zone_2 (Jetson)
NODE_ID=Noeud_Edge_Zone_1

# Identifiant de zone géographique / logique (Zone_1 ou Zone_2)
ZONE_ID=Zone_1

# Adresse IP LAN réelle de cette machine Edge (accessible par les streamers et viewers)
NODE_HOST=192.168.1.50

# Port d'écoute WebSocket pour l'upload et le download direct des blocs vidéo
# - Standard : 8444 (Zone 1) ou 8447 (Zone 2)
EDGE_WS_PORT=8444

# Protocole WebSocket : ws (développement non chiffré) ou wss (production TLS)
EDGE_WS_SCHEME=ws

# Adresse IP et port de la machine hébergeant le Broker MQTT de la zone
BROKER_HOST=192.168.1.10
BROKER_PORT=1883

# URL du serveur Crypto de la zone (utilisé pour les signatures déléguées et le transcodage Fog)
# - Zone 1 : https://192.168.1.20:8443
# - Zone 2 : https://192.168.1.21:8443 (ou port 8445 si sur la même machine)
CRYPTO_URL=https://192.168.1.20:8443

# Répertoire de stockage isolé des blocs vidéo sur le conteneur
EDGE_DATA_DIR=/donnees_isolees

# Intervalle d'émission de la télémétrie vers MQTT en secondes
TELEMETRY_INTERVAL_SEC=5
