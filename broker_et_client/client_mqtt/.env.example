# Copiez ce fichier en .env et renseignez les adresses de votre réseau local

# Adresse IP ou nom DNS de la machine hébergeant le Broker MQTT
BROKER_IP=192.168.1.10

# Adresse IP ou nom DNS de cette machine Edge, accessible par le serveur Web
NODE_IP=192.168.1.20

# Informations sur le noeud
NODE_ID=Edge_Node_1
ZONE_ID=Zone_1

# Réglages orientés faible latence
STREAM_QUEUE_SIZE=64
STORAGE_QUEUE_SIZE=512
STORAGE_BATCH_SIZE=32
STORAGE_FLUSH_SECONDS=0.5
UPLOAD_ACK_EVERY=0
