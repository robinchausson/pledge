# --- NŒUD EDGE DE STOCKAGE & STREAMING ---
# Identifiant unique de ce nœud Edge sur le réseau
NODE_ID=Noeud_Edge_01

# Identifiant de zone géographique / logique
ZONE_ID=Zone_1

# Adresse IP LAN réelle de cette machine Edge (accessible par le serveur web)
NODE_HOST=192.168.1.50

# Port d'écoute WebSocket pour l'upload et le download vidéo
EDGE_WS_PORT=8444

# Protocole WebSocket : ws (développement non chiffré) ou wss (production TLS)
EDGE_WS_SCHEME=ws

# Adresse IP et port de la machine hébergeant le Broker MQTT
BROKER_HOST=192.168.1.10
BROKER_PORT=1883

# Répertoire de stockage des données sur le conteneur
EDGE_DATA_DIR=/donnees_isolees

# Intervalle d'émission de la télémétrie en secondes
TELEMETRY_INTERVAL_SEC=5
