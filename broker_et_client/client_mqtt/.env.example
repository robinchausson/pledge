# Copiez ce fichier en .env et remplacez par les vraies IP Tailscale

# IP Tailscale de la machine hébergeant le Broker MQTT
TAILSCALE_IP_BROKER=100.x.x.x

# IP Tailscale DE CETTE MACHINE (le Edge Node), indispensable pour que le serveur Web puisse lui envoyer des flux
TAILSCALE_IP_NODE=100.x.x.x

# Informations sur le noeud
NODE_ID=Tailscale_Edge_Node_1
ZONE_ID=Zone_1
