# ==========================================
# Pledge - .gitignore
# Protection contre la pollution du dépôt GitHub
# ==========================================

# --- 1. Variables d'Environnement & Secrets ---
.env
.env.*
*.env
*.env.local
broker_et_client/client_mqtt/.env
serveur_web/.env
!.env.example
!**/.env.example
!*.env.example

# --- 2. Dépendances & Builds Frontend / Node.js ---
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.dist/
.vite/
**/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 3. Environnements Virtuels & Caches Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
*.egg
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- 4. Bases de Données & Données Persistantes ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
**/data/
!data/.gitkeep
!**/data/.gitkeep

# --- 5. Données de Flux Vidéo & Volumes Stockage Fog ---
donnees_isolees/
**/donnees_isolees/
stockage_isole_*/
**/stockage_isole_*/
volumes/
**/volumes/
# Fichiers binaires de flux et fragments vidéo
*.dat
*.webm
*.mp4
*.mkv
*.avi
*.mov
*.ts
*.h264
*.h265

# --- 6. Brokers MQTT (Mosquitto) ---
mosquitto_data/
**/mosquitto_data/
mosquitto_log/
**/mosquitto_log/

# --- 7. Certificats TLS & Clés Privées ---
certs/
**/certs/
!certs/.gitkeep
!**/certs/.gitkeep
*.crt
*.key
*.pem
*.pfx
*.p12
*.csr

# --- 8. Journaux & Logs Système ---
*.log
**/*.log
logs/
**/logs/

# --- 9. Fichiers Lourds & Documents Externes ---
*.pdf

# --- 10. Éditeurs & Systèmes d'Exploitation ---
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
