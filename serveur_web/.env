# --- SERVEUR WEB (BACKEND & FRONTEND) ---

# URL d'accès public à l'API Backend (IP de cette machine hôte avec le port 8000)
LAN_URL_BACKEND=http://10.78.252.50:8000
VITE_API_URL=http://10.78.252.50:8000

# Ports d'écoute sur la machine hôte
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Adresse et port de la machine hébergeant le Broker MQTT
BROKER_HOST=10.78.252.187
BROKER_PORT=1883

# Préfixe du client MQTT (un identifiant unique sera automatiquement suffixé)
MQTT_CLIENT_ID_PREFIX=backend_web

# URLs des serveurs crypto par zone (hébergé sur le PC collègue 10.78.252.138)
CRYPTO_URL_ZONE_1=https://10.78.252.138:8443
CRYPTO_URL_ZONE_2=https://10.78.252.138:8443

# Vérification TLS pour les appels au serveur Crypto (false pour certificats autosignés de dev, true en prod)
CRYPTO_VERIFY_SSL=false

# URL de connexion à la base de données (SQLite par défaut, ou postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./data/app.db

# Schéma par défaut pour joindre les nœuds Edge (ws ou wss)
EDGE_WS_SCHEME=ws
