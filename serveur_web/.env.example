# --- SERVEUR WEB (BACKEND & FRONTEND) ---

# URL d'accès public à l'API Backend (IP de cette machine hôte avec le port 8000)
LAN_URL_BACKEND=http://192.168.1.100:8000
VITE_API_URL=http://192.168.1.100:8000

# Ports d'écoute sur la machine hôte
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- BROKERS MQTT PAR ZONE ---
BROKER_HOST_ZONE_1=192.168.1.10
BROKER_PORT_ZONE_1=1883
BROKER_TLS_ZONE_1=false
BROKER_HOST_ZONE_2=192.168.1.11
BROKER_PORT_ZONE_2=1883
BROKER_TLS_ZONE_2=false

# Préfixe du client MQTT (un identifiant unique sera automatiquement suffixé)
MQTT_CLIENT_ID_PREFIX=backend_web

# --- SERVEURS CRYPTO PAR ZONE ---
CRYPTO_URL_ZONE_1=https://192.168.1.20:8443
CRYPTO_URL_ZONE_2=https://192.168.1.21:8443
CRYPTO_VERIFY_SSL=false

# URL de connexion à la base de données (SQLite par défaut, ou postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./data/app.db

# Schéma par défaut pour joindre les nœuds Edge (ws ou wss)
EDGE_WS_SCHEME=ws
