# Copiez ce fichier en .env et remplacez par les vraies IP Tailscale
# URL de l'API (IP Tailscale de ce serveur web, avec port 8000)
TAILSCALE_URL_BACKEND=http://100.x.x.x:8000

# IP Tailscale de la machine hébergeant le Broker MQTT
TAILSCALE_IP_BROKER=100.x.x.x

# URL HTTPS (IP Tailscale) du serveur crypto de la Zone 1
TAILSCALE_URL_CRYPTO_1=https://100.x.x.x:8443
