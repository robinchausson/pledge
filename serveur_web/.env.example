# Copiez ce fichier en .env et renseignez les adresses de votre réseau local
# URL de l'API accessible par le navigateur
VITE_API_URL=http://192.168.1.30:8000

# Adresse IP ou nom DNS de la machine hébergeant le Broker MQTT
BROKER_IP=192.168.1.10

# URL HTTPS du serveur crypto de la Zone 1
CRYPTO_URL_ZONE_1=https://192.168.1.40:8443

# Schéma utilisé pour joindre les Edge depuis le backend : ws ou wss
EDGE_WS_SCHEME=ws

# Laisser désactivé pour préserver la latence du streaming
STREAM_CRYPTO_INLINE=false

# Clé de signature JWT, longue et aléatoire, différente en production
SECRET_KEY=remplacer_par_une_cle_secrete_longue
