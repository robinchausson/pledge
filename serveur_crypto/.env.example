# --- SERVEUR CRYPTO DE ZONE (FastAPI / BN128 / SIS L'Ecuyer) ---

# Identifiant de la zone (Zone_1 pour le PC fixe, Zone_2 pour le second PC / Jetson)
ZONE_ID=Zone_1

# Port d'écoute HTTPS sur la machine hôte
# Standard : 8443 (sur machine dédiée).
# En colocalisation sur la même machine hôte : 8443 pour Zone 1, 8445 pour Zone 2.
CRYPTO_PORT=8443

# Scalaire secret maître de la zone (génération de PK_s et signatures Hess-IBS)
# Valeurs déterministes du banc d'essai :
# - Zone 1 : 123456789
# - Zone 2 : 987654321
CRYPTO_SECRET_SCALAR=123456789

# Chemins des certificats TLS dans le conteneur (génération autosignée automatique si absents)
TLS_CERT_FILE=/certs/tls.crt
TLS_KEY_FILE=/certs/tls.key
